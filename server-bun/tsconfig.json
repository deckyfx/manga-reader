{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["./client/*"]
    }
  },
  "include": ["src/**/*", "client/**/*", "scripts/**/*", "build.ts", "drizzle.config.ts"]
}
