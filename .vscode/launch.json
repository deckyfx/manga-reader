{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: Launch (bun)",
      "type": "bun",
      "request": "launch",
      "program": "src/index.ts",
      "cwd": "${workspaceFolder}/server",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "name": "Server: Attach (bun)",
      "type": "bun",
      "request": "attach",
      "url": "ws://localhost:6499/"
    },
    {
      "name": "Desktop: Launch (dotnet)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "desktop: dotnet build",
      "program": "${workspaceFolder}/desktop/bin/Debug/net10.0/WebOcrDesktop.dll",
      "args": [],
      "cwd": "${workspaceFolder}/desktop",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
