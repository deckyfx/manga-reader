{
  "version": "2.0.0",
  "tasks": [
    // ── Server (Bun) ──────────────────────────────────────────────────────────
    {
      "label": "server: dev",
      "type": "shell",
      "command": "bun run dev",
      "group": "none",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "server: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "group": "test",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "server: build",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "server: db generate",
      "type": "shell",
      "command": "bun run db:generate",
      "group": "none",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Extension ─────────────────────────────────────────────────────────────
    {
      "label": "extension: build",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "extension: build:dev",
      "type": "shell",
      "command": "bun run build:dev",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "extension: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "group": "test",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Desktop ───────────────────────────────────────────────────────────────
    {
      "label": "desktop: dotnet build",
      "type": "shell",
      "command": "dotnet build",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}/desktop" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "desktop: dotnet run",
      "type": "shell",
      "command": "dotnet run",
      "group": "none",
      "options": { "cwd": "${workspaceFolder}/desktop" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": "$msCompile"
    }
  ]
}
