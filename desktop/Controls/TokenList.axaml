<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MangaReaderDesktop.ViewModels"
             xmlns:c="using:MangaReaderDesktop.Controls"
             xmlns:m="using:MangaReaderDesktop.Models"
             x:Class="MangaReaderDesktop.Controls.TokenList"
             x:DataType="vm:MainViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="300">
        <ItemsControl ItemsSource="{Binding TokenCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:TokenCardModel">
                    <c:TokenCard DataContext="{Binding}" Margin="4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
