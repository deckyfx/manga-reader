# Server
PORT=3579
NODE_ENV=development
# Loopback by default. 0.0.0.0 opens it to the network. Plain http is for development only: passwords and session
# cookies then cross the network in clear. Any real deployment reachable beyond this machine needs TLS in front.
HOST=127.0.0.1
# Behind a reverse proxy you run that terminates TLS: its X-Forwarded-Proto / X-Forwarded-For are believed from it
# alone. "true" = a proxy on this machine; otherwise list its addresses, comma-separated.
# TRUST_PROXY=true

# Database
DATABASE_URL=./data/ocr.db

# Seals TOTP secrets in the database (32 bytes, base64). Left unset, data/secret.key is created on first use.
# Back it up with the database: without it, enrolled authenticator apps stop working and have to be set up again.
# SECRET_KEY=

# Model directories (these are the defaults; models download here on first start)
OCR_MODELS_DIR=./data/models/ocr
TRANSLATE_MODELS_DIR=./data/models/translate
INPAINT_MODELS_DIR=./data/models/inpaint
BUBBLE_MODELS_DIR=./data/models/bubble
TEXT_SEG_MODELS_DIR=./data/models/textseg
DICT_DIR=./data/models/jdict

# HuggingFace model repos
OCR_MODEL_REPO=mayocream/manga-ocr-onnx
OCR_MODEL_ENABLED=true
TRANSLATE_MODEL_REPO=Xenova/opus-mt-ja-en
TRANSLATE_MODEL_ENABLED=true
INPAINT_MODEL_REPO=Carve/LaMa-ONNX
INPAINT_MODEL_ENABLED=false
BUBBLE_MODEL_REPO=ogkalu/comic-text-and-bubble-detector
BUBBLE_MODEL_ENABLED=false
TEXT_SEG_MODEL_REPO=zyddnys/manga-image-translator
TEXT_SEG_MODEL_ENABLED=false

# Translation engine: auto | local | deepl
PREFERRED_TRANSLATION_ENGINE=auto

# Inpaint engine: auto | lama | flood_fill
INPAINT_ENGINE=auto

# DeepL API key (optional — enables DeepL translation)
# DEEPL_API_KEY=

# Unix socket path (optional — if set, listens on socket instead of TCP)
# SOCKET_PATH=
