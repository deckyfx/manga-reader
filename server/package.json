{
  "name": "manga-reader-server",
  "version": "0.1.0",
  "description": "manga-reader server: OCR, translation, page pipeline and the Studio (Bun, Elysia, Drizzle, onnxruntime-node)",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/boot.ts",
    "start": "./dist/app",
    "build": "bun run embed:migrations && bun run typecheck && bun run build.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "types:api": "tsc -p tsconfig.api.json",
    "db:generate": "drizzle-kit generate && bun run embed:migrations",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "embed:migrations": "bun run scripts/embed-migrations.ts",
    "ocr:compare": "bun run scripts/ocr-compare.ts",
    "page": "bun run scripts/page.ts",
    "regress": "bun run scripts/regress.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "reflect-metadata": "^0.2.2",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@huggingface/hub": "^2.17.8",
    "@patdx/kuromoji": "1.0.4",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.3",
    "deepl-node": "^1.28.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "fabric": "7.4.0",
    "fflate": "^0.8.3",
    "hyphen": "^1.14.1",
    "lucide-react": "^1.58.0",
    "onnxruntime-node": "^1.30.0",
    "opentype.js": "^2.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/hyphen": "^1.14.0",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
