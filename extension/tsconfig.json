{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "chrome"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Server declarations (types:api) keep the server's "@/" imports; resolve them to the emitted types.
    // "elysia" must resolve to the server's copy: Elysia's classes have private members, so types from two
    // installed copies are incompatible and treaty<Api> would reject the server app.
    "paths": {
      "@/*": ["../server/types/src/*"],
      "elysia": ["../server/node_modules/elysia"],
      "elysia/*": ["../server/node_modules/elysia/*"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
